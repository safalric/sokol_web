{
  "name": "tj-sokol-doudleby-web",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.9.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --configLoader native",
    "build": "pnpm content:check && vite build --configLoader native && node scripts/create-sites-worker.mjs",
    "content:check": "node scripts/validate-content.mjs",
    "check": "pnpm content:check && tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1 --configLoader native",
    "preview:worker": "node scripts/preview-worker.mjs",
    "test": "vitest run",
    "test:api": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "qa": "pnpm check && pnpm test && pnpm test:api && pnpm build && pnpm test:e2e"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "axe-core": "4.13.0",
    "jsdom": "26.1.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "4.1.10"
  }
}
