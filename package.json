{
  "name": "tj-sokol-doudleby-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --configLoader native",
    "build": "vite build --configLoader native && node scripts/create-sites-worker.mjs",
    "check": "tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1 --configLoader native",
    "preview:worker": "node scripts/preview-worker.mjs",
    "test:api": "node --test tests/*.test.mjs",
    "qa": "pnpm check && pnpm test:api && pnpm build"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17"
  }
}
