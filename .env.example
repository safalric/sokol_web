# VZOR KONFIGURACE SERVERU / CLOUDFLARE WORKERU
# ------------------------------------------------------------
# Tento soubor nikdy neobsahuje skutecne klice. Zkopirujte pouze nazvy
# promennych do zabezpecene konfigurace hostingu (napr. `wrangler secret put`).
# Citlive hodnoty nesmi mit prefix VITE_, protoze Vite je vklada do frontendu.
#
# Kdyz promenne zustanou prazdne nebo je konfigurace jen castecna, API se
# bezpecne prepne do DEMO rezimu a neposle zadny e-mail ani data tretim stranam.

# VEREJNA KANONICKA ADRESA
# Po pripojeni ostre domeny nastavte napr. https://sokoldoudleby.cz.
# Pouziva se pro canonical, OpenGraph, robots.txt a sitemap.xml.
PUBLIC_SITE_URL=

# GOOGLE KALENDAR
# Obe hodnoty jsou nutne pro zivy kalendar. API klic omezte pouze na
# Google Calendar API a pokud mozno i na konkretni verejny kalendar.
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_API_KEY=

# MONITORING A RELEASE
# Pokud je true, /api/health vrati HTTP 503, dokud kalendar
# nebezi v produkcnim rezimu. Zapnete po pripojeni verejneho kalendare.
HEALTH_EXPECT_LIVE=false
RELEASE_SHA=
