GOOGLE_CALENDAR_API_KEY=google-calendar-readonly-api-key

RESEND_API_KEY=re_xxxxxxxxx
REGISTRATION_FROM_EMAIL=prihlasky@your-verified-domain.cz
REGISTRATION_ORGANIZER_EMAIL=sokoldoudleby@seznam.cz

GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/DEPLOYMENT_ID/exec
