# VZOR KONFIGURACE SERVERU / CLOUDFLARE WORKERU
# ------------------------------------------------------------
# Tento soubor nikdy neobsahuje skutecne klice. Zkopirujte pouze nazvy
# promennych do zabezpecene konfigurace hostingu (napr. `wrangler secret put`).
# Citlive hodnoty nesmi mit prefix VITE_, protoze Vite je vklada do frontendu.
#
# Kdyz promenne zustanou prazdne nebo je konfigurace jen castecna, API se
# bezpecne prepne do DEMO rezimu a neposle zadny e-mail ani data tretim stranam.

# VEREJNA KANONICKA ADRESA
# Po pripojeni ostre domeny nastavte napr. https://sokoldoudleby.cz.
# Pouziva se pro canonical, OpenGraph, robots.txt a sitemap.xml.
PUBLIC_SITE_URL=

# GOOGLE KALENDAR
# Obe hodnoty jsou nutne pro zivy kalendar. API klic omezte pouze na
# Google Calendar API a pokud mozno i na konkretni verejny kalendar.
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_API_KEY=

# E-MAILY PRIHLASEK PRES RESEND
# Odesilaci adresa musi patrit k overene domene v Resend.
# Organizatorovi prijde provozni kopie bez zdravotnich udaju.
RESEND_API_KEY=
REGISTRATION_FROM_EMAIL=
REGISTRATION_TRIP_ORGANIZER_EMAIL=
REGISTRATION_CAMP_ORGANIZER_EMAIL=

# GOOGLE SHEETS WEBHOOK
# Webhook musi overovat sdilene tajemstvi, mit omezeny pristup k tabulce
# a chranit bunky pred formula injection. URL ani secret nepatri do frontendu.
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_WEBHOOK_SECRET=

# GLOBALNI RATE LIMIT
# Nahodny retezec minimalne 32 znaku pouzity pouze k jednosmernemu hashovani IP.
# Ostry rezim jej vyzaduje spolu s D1 bindingem DB z hosting.json.
RATE_LIMIT_HASH_SECRET=

# CLOUDFLARE TURNSTILE
# Site key je verejny identifikator, secret key zustava vyhradne na serveru.
# Ostry rezim registraci se aktivuje jen s kompletni konfiguraci vsech sluzeb.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# CITLIVE ZDRAVOTNI UDAJE
# Ponechte false, dokud vedeni neschvali pravni titul, omezene uloziste,
# pristupove role, dobu uchovani a overeny proces vymazu. Zdravotni udaje
# se nikdy neposilaji e-mailem.
REGISTRATION_HEALTH_DATA_ENABLED=false

# MONITORING A RELEASE
# Pokud je true, /api/health vrati HTTP 503, dokud kalendar i prihlasovani
# nebezi v produkcnim rezimu. Zapnete az po nastaveni vsech integraci.
HEALTH_EXPECT_LIVE=false
RELEASE_SHA=
