# VZOR KONFIGURACE SERVERU / CLOUDFLARE WORKERU
# ------------------------------------------------------------
# Tento soubor nikdy neobsahuje skutecne klice. Zkopirujte pouze nazvy
# promennych do zabezpecene konfigurace hostingu (napr. `wrangler secret put`).
# Citlive hodnoty nesmi mit prefix VITE_, protoze Vite je vklada do frontendu.
#
# Publikacni verze: kalendar pouziva mistni potvrzene terminy bez Google uctu.
# Prazdny src/data/registration-events.json UZAVIRA API prihlasovani,
# bez cteni tela zadosti a bez odesilani. Testovaci akce jsou jen v tests/fixtures.
# Integrace nize se pripravuji az pro dalsi etapu.

# VEREJNA KANONICKA ADRESA
# Po pripojeni ostre domeny nastavte napr. https://sokoldoudleby.cz.
# Pouziva se pro canonical, OpenGraph, robots.txt a sitemap.xml.
PUBLIC_SITE_URL=

# GOOGLE KALENDAR
# Nepovinne. Bez obou hodnot se pouzije src/data/calendar-events.json.
# Jen zaznamy s published: true, platnym datem a HTTPS sourceUrl se zverejni.
# Obe hodnoty jsou nutne pro zivy kalendar. API klic omezte pouze na
# Google Calendar API; pristup ke konkretnimu kalendari se neridi omezenim
# API klice. Publikujte pouze program, nikdy udaje ucastniku nebo prihlasky.
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_API_KEY=

# E-MAILY PRIHLASEK PRES RESEND
# Odesilaci adresa musi patrit k overene domene v Resend.
# Organizatorovi prijde provozni kopie bez zdravotnich udaju.
# Volne textove poznamky zustavaji take pouze v omezene evidenci, ne v e-mailu.
# Navic musi mit skutecna akce v src/data/registration-events.json
# productionApproved: true. Ukazkove akce ponechte false; nedostanou zive prihlaseni.
RESEND_API_KEY=
REGISTRATION_FROM_EMAIL=
REGISTRATION_TRIP_ORGANIZER_EMAIL=
REGISTRATION_CAMP_ORGANIZER_EMAIL=

# SIFROVANA FRONTA POTVRZENI (povinna soucast ostreho rezimu)
# REGISTRATION_OUTBOX_KEY: 32 nahodnych bajtu zakodovanych standardnim Base64.
# Klic je pouze v tajemstvich serveru; neposilat do GitHub Actions ani frontendu.
# REGISTRATION_JOBS_TOKEN: jine nahodne tajemstvi, alespon 32 znaku.
# Stejny jobs token dostane planovac. Aktivujte jej podle docs/registration-delivery.md.
# Bez beziciho planovace nelze garantovat opakovani e-mailu ani uklid evidence.
REGISTRATION_OUTBOX_KEY=
REGISTRATION_JOBS_TOKEN=

# GOOGLE SHEETS WEBHOOK
# Webhook musi overovat sdilene tajemstvi, mit omezeny pristup k tabulce
# a chranit bunky pred formula injection. URL ani secret nepatri do frontendu.
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_WEBHOOK_SECRET=

# GLOBALNI RATE LIMIT
# Nahodny retezec minimalne 32 znaku pouzity pouze k jednosmernemu hashovani IP.
# Ostry rezim jej vyzaduje spolu s D1 bindingem DB z hosting.json.
RATE_LIMIT_HASH_SECRET=

# CLOUDFLARE TURNSTILE
# Site key je verejny identifikator, secret key zustava vyhradne na serveru.
# Ostry rezim registraci se aktivuje jen s kompletni konfiguraci vsech sluzeb.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# CITLIVE ZDRAVOTNI UDAJE
# Ponechte false, dokud vedeni neschvali pravni titul, omezene uloziste,
# pristupove role, dobu uchovani a overeny proces vymazu. Zdravotni udaje
# se nikdy neposilaji e-mailem.
REGISTRATION_HEALTH_DATA_ENABLED=false

# MONITORING A RELEASE
# Pokud je true, /api/health vrati HTTP 503, dokud neni kompletni konfigurace
# kalendare a prihlasovani. Nekontroluje dorucitelnost e-mailu ani dostupnost
# poskytovatelu; tu je nutne overit oddelenym integracnim testem.
HEALTH_EXPECT_LIVE=false
RELEASE_SHA=
